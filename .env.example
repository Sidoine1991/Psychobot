# Psychobot - Environment Configuration Example
# Rename this file to .env and fill in the values below.

# --- Required: AI Features ---
# Get your key at https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# --- Required: Audio Transcription (OpenAI Whisper) ---
# Get your key at https://platform.openai.com/account/api-keys
# Required for audio message processing
OPENAI_API_KEY=sk_your_key_here

# --- Required: Bot Owner Setup ---
# Your international phone number (e.g., 2290196911346)
OWNER_NUMBER=2290196911346

# Professional IDs (LIDS) for additional owner permissions
# Comma-separated list
OWNER_IDS=250865332039895,85483438760009,128098053963914,243941626613920

# --- Optional: Deployment & Maintenance ---
# Render App URL for automated keep-alive (e.g., https://psychobot.onrender.com)
RENDER_URL=
# Used for automatic session persistence. Get your API key in Render Settings > API Keys.
RENDER_API_KEY=
# Leave RENDER_SERVICE_ID empty; Render sets this automatically.
RENDER_SERVICE_ID=

# Server Port (Default: 10000)
PORT=10000

# Base64 session string for persistence on cloud platforms
SESSION_DATA=

# --- Optional: Career-Ops / K_JobAgent (WhatsApp notify from n8n) ---
# Recipient JID: country code + number without +, e.g. 229019691346@s.whatsapp.net
CAREER_OPS_NOTIFY_JID=
# Shared secret with n8n (header x-career-ops-secret); leave empty to disable auth
CAREER_OPS_WEBHOOK_SECRET=
# URLs shown by !careerops
PSYCHOBOT_PUBLIC_URL=https://psychobot-1si7.onrender.com/
CAREER_OPS_SHEETS_URL=https://docs.google.com/spreadsheets/d/1Hjy8UDug0VfY0VCGV8Mbrmez1q2SwH0c6oe1_9ST7JE/edit
